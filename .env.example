# Copy to .env (on the live server, /opt/tova/.env) and fill in real values.
# Never commit real secrets. .env is git-ignored; docker-compose.live.yml loads it via env_file.

# Secrets (set for backend container)
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# Fireworks AI (issue #232) — the second serverless provider on the model
# roster; every roster model's turn is raced across DeepInfra and Fireworks.
FIREWORKS_API_KEY=
JWT_SECRET=
# The server always uses MONGODB_URL when set (verbatim, incl. the password in
# the URL), for both plain Mongo and Atlas. Atlas uses the `mongodb+srv://` scheme:
#   MONGODB_URL=mongodb+srv://tova:<db_password>@<cluster-host>/?appName=<app>
# (placeholder only — set the real value in .env, never in this file).
# Unset: dev fallback assembles mongodb://tova:<MONGODB_PASSWORD>@<MONGODB_HOST>/tova
# (authSource=admin) — keep MONGODB_PASSWORD set so the docker compose stacks work.
MONGODB_URL=
MONGODB_PASSWORD=
# Source URI for `npm run db:dump` / `db:sync` (production/Atlas), read verbatim.
# Same scheme rules as MONGODB_URL. Only needed for database snapshots.
#   MONGODB_DUMP_URL=mongodb+srv://tova:<db_password>@<cluster-host>/tova?appName=<app>
MONGODB_DUMP_URL=

# Google OAuth sign-in (required). Register a Google OAuth client (Web
# application) at Google Cloud Console with authorized redirect URI
# http://localhost:5173/api/auth/google/callback for dev and
# https://<prod-host>/api/auth/google/callback for prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Brave Search API key (web_search tool, issue #16) — optional; the agent has
# no search tool at all when unset, so plain chat keeps working in dev.
BRAVE_SEARCH_API_KEY=

# Safe Browsing link checker (issue #120) — optional; every URL the agent
# fetches via fetch_url is screened against Google's threatMatches endpoint
# (initial URL plus each redirect hop), with a domain-level Mongo cache
# (24h TTL). Unset → fetch_url works unchanged, unchecked. Accepts
# GOOGLE_SAFE_BROWSING_API_KEY or a generic GOOGLE_API_KEY (an OAuth client
# secret pair from sign-in is NOT usable; enable the Safe Browsing API in the
# same Google Cloud project to get a plain API key).
GOOGLE_SAFE_BROWSING_API_KEY=

# DigitalOcean Spaces asset storage (issue #34) — optional; the asset library
# is disabled while any of these is missing (server degrades gracefully, same
# pattern as BRAVE_SEARCH_API_KEY). The key pair has read/write/delete on the
# `tova` bucket only — not bucket-policy permission, so never create buckets
# or change ACLs with it. Objects stay private; downloads use presigned GETs.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Spaces region for the endpoint (confirmed lon1 from a real presigned PUT).
DO_SPACES_REGION=lon1

# LangSmith tracing (issue #5) — optional; nothing is exported unless the API
# key is present. With the key set, every LLM call is traced hierarchically
# (agent run → step → inference → llm, token usage + latency). LANGCHAIN_PROJECT
# selects the LangSmith project traces land in (default project when unset).
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=tova

# Connector auth (issue #36, #329) — secret used to encrypt connector auth
# material at rest (AES-256-GCM). Personal connectors with token auth cannot
# be added while this is unset. Generate with: openssl rand -hex 32
MCP_ENCRYPTION_KEY=

# Personal access token (issue #184) — for agents/CLI scripts hitting admin
# API endpoints. Generate in the admin view's Access tab (shown once; only
# its sha256 is stored server-side), paste here, and send it as
# `Authorization: Bearer $TOVA_PAT`. Inherits the creator's live role;
# revoke by deleting the row in the Access tab. Local-only: not read by the
# server, only by scripts (e.g. the #179 logs CLI).
# Tokens are per-environment: generate one against the local admin view and
# one against the live deployment — paste them as TOVA_PAT_LOCAL and TOVA_PAT
# respectively so both can live in this file.
TOVA_PAT_LOCAL=
TOVA_PAT=

# Aux model (issue #238) — the single cheap, latency-insensitive model for the
# auxiliary LLM calls: chat titles, follow-up suggestions, prompt-metric
# classification, and the enrichment pass. Replaces the tier-era
# ROUTER_SMALL_MODEL / ROUTER_GUARD_MODEL. Defaults to the retired guard model
# on its old provider so wire behaviour is unchanged.
AUX_MODEL=openai/gpt-oss-20b
AUX_PROVIDER=groq

# Workspace memory (issue #253, epic #251) — retrieval across the user's own
# past work (chats + files) into the system prompt. The same aux enrichment call
# gains a `workspace` vote ("is the turn referring back to past work?"); a
# positive vote triggers a bounded, lexical retrieval over the user's messages
# and extracted-asset text, injected as a <user:workspace> block. Defaults OFF:
# a wrong injection pollutes every turn, so the block ships opt-in until the
# gate evals exist (set 1 to enable). ZDR/incognito turns are never corpus
# items; a ZDR turn may still read the map read-only.
WORKSPACE_MEMORY_ENABLED=

# Workspace semantic retrieval (issue #294) — embeddings + Atlas Vector Search,
# the semantic half of workspace memory. EMBEDDING_MODEL names a DeepInfra
# embeddings model (default BAAI/bge-base-en-v1.5); EMBEDDING_DIM must match the
# model and the Atlas index's numDimensions (fixed at index creation, so a model
# switch is a config change plus a re-index and re-backfill). EMBEDDING_TIMEOUT_MS
# bounds the per-turn query embed + $vectorSearch before retrieval degrades to
# the lexical result (default 800). Embeddings reuse DEEPINFRA_API_KEY.
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_TIMEOUT_MS=

# Deterministic evals (issue #225) — the scheduled eval suite. Off by default:
# a fresh deploy must not start live provider calls unattended. Set
# TOVA_EVAL_SCHEDULE=daily to run once per UTC day (at/after TOVA_EVAL_HOUR_UTC,
# default 0 = midnight); restarts do not double-run. Manual "Run now" in the
# admin Evals tab works regardless. TOVA_EVAL_MODELS overrides the model set as
# a `provider:model,...` csv (default: TOVA_EVAL_MODEL on TOVA_EVAL_PROVIDER,
# GLM 5.3 Flash on deepinfra — the cheapest roster model).
TOVA_EVAL_SCHEDULE=off
TOVA_EVAL_HOUR_UTC=
TOVA_EVAL_MODELS=
