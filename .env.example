# Copy to .env (on the live server, /opt/tova/.env) and fill in real values.
# Never commit real secrets. .env is git-ignored; docker-compose.live.yml loads it via env_file.

# Secrets (set for backend container)
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# Fireworks AI (issue #232) — the second serverless provider on the model
# roster; every roster model's turn is raced across DeepInfra and Fireworks.
FIREWORKS_API_KEY=
JWT_SECRET=
# Password for the seeded admin account (email hardcoded in the admin-seed
# migration, formsatz@gmail.com). Required: `npm run db:migrate` refuses to
# seed the admin user when this is unset rather than falling back to a
# known default.
ADMIN_PASSWORD=
# The server always uses MONGODB_URL when set (verbatim, incl. the password in
# the URL), for both plain Mongo and Atlas. Atlas uses the `mongodb+srv://` scheme:
#   MONGODB_URL=mongodb+srv://tova:<db_password>@<cluster-host>/?appName=<app>
# (placeholder only — set the real value in .env, never in this file).
# Unset: dev fallback assembles mongodb://tova:<MONGODB_PASSWORD>@<MONGODB_HOST>/tova
# (authSource=admin) — keep MONGODB_PASSWORD set so the docker compose stacks work.
MONGODB_URL=
MONGODB_PASSWORD=
