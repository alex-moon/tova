# Copy to .env (on the live server, /opt/tova/.env) and fill in real values.
# Never commit real secrets. .env is git-ignored; docker-compose.live.yml loads it via env_file.

# Secrets (set for backend container)
GROQ_API_KEY=
DEEPINFRA_API_KEY=
JWT_SECRET=
# The server always uses MONGODB_URL when set (verbatim, incl. the password in
# the URL), for both plain Mongo and Atlas. Atlas uses the `mongodb+srv://` scheme:
#   MONGODB_URL=mongodb+srv://tova:<db_password>@<cluster-host>/?appName=<app>
# (placeholder only — set the real value in .env, never in this file).
# Unset: dev fallback assembles mongodb://tova:<MONGODB_PASSWORD>@<MONGODB_HOST>/tova
# (authSource=admin) — keep MONGODB_PASSWORD set so the docker compose stacks work.
MONGODB_URL=
MONGODB_PASSWORD=

# Google OAuth sign-in (required). Register a Google OAuth client (Web
# application) at Google Cloud Console with authorized redirect URI
# http://localhost:5173/api/auth/google/callback for dev and
# https://<prod-host>/api/auth/google/callback for prod.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Brave Search API key (web_search tool, issue #16) — optional; the agent has
# no search tool at all when unset, so plain chat keeps working in dev.
BRAVE_SEARCH_API_KEY=

# Safe Browsing link checker (issue #120) — optional; every URL the agent
# fetches via fetch_url is screened against Google's threatMatches endpoint
# (initial URL plus each redirect hop), with a domain-level Mongo cache
# (24h TTL). Unset → fetch_url works unchanged, unchecked. Accepts
# GOOGLE_SAFE_BROWSING_API_KEY or a generic GOOGLE_API_KEY (an OAuth client
# secret pair from sign-in is NOT usable; enable the Safe Browsing API in the
# same Google Cloud project to get a plain API key).
GOOGLE_SAFE_BROWSING_API_KEY=

# DigitalOcean Spaces asset storage (issue #34) — optional; the asset library
# is disabled while any of these is missing (server degrades gracefully, same
# pattern as BRAVE_SEARCH_API_KEY). The key pair has read/write/delete on the
# `tova` bucket only — not bucket-policy permission, so never create buckets
# or change ACLs with it. Objects stay private; downloads use presigned GETs.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Spaces region for the endpoint (confirmed lon1 from a real presigned PUT).
DO_SPACES_REGION=lon1

# LangSmith tracing (issue #5) — optional; nothing is exported unless the API
# key is present. With the key set, every LLM call is traced hierarchically
# (agent run → step → inference → llm, token usage + latency). LANGCHAIN_PROJECT
# selects the LangSmith project traces land in (default project when unset).
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=tova

# MCP support (issue #36) — secret used to encrypt MCP server auth headers at
# rest (AES-256-GCM). Personal MCP servers with an auth header cannot be added
# while this is unset. Generate with: openssl rand -hex 32
MCP_ENCRYPTION_KEY=
# Entity graph (issue #138) — per-user relationship memory, optional. With
# ENTITY_GRAPH_ENABLED set, each completed non-ZDR turn triggers one extra
# fire-and-forget LLM call that merges durable entities + stated
# relationships into the user's graph. With ENTITY_GRAPH_PROMPT_INJECTION
# also set, a compact (character-capped) "what we know about you" block is
# injected into the system prompt at assembly. Both default off.
# With ENTITY_GRAPH_PROMPT_INJECTION set, retrieval also surfaces the top
# matched entities + edges as a bounded "past chats" block in the system
# prompt (read-only; retrieval failure degrades to no block). Leave empty to
# disable.
# NOTE (issue #138, 2026-09-21): real Atlas (cluster + Search/Vector indexes)
# is a separate setup task owned by Alex — everything here runs on plain
# local Mongo, and both extraction and retrieval degrade to a logged no-op /
# empty block when the store or the extraction LLM is unavailable.
ENTITY_GRAPH_ENABLED=
ENTITY_GRAPH_PROMPT_INJECTION=
