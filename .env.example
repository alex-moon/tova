# Copy to .env (on the live server, /opt/tova/.env) and fill in real values.
# Never commit real secrets. .env is git-ignored; docker-compose.live.yml loads it via env_file.

# Secrets (set for backend container)
GROQ_API_KEY=
JWT_SECRET=
MONGODB_PASSWORD=

# Brave Search API key (web_search tool, issue #16) — optional; the agent has
# no search tool at all when unset, so plain chat keeps working in dev.
BRAVE_SEARCH_API_KEY=

# DigitalOcean Spaces asset storage (issue #34) — optional; the asset library
# is disabled while any of these is missing (server degrades gracefully, same
# pattern as BRAVE_SEARCH_API_KEY). The key pair has read/write/delete on the
# `tova` bucket only — not bucket-policy permission, so never create buckets
# or change ACLs with it. Objects stay private; downloads use presigned GETs.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Spaces region for the endpoint (confirmed lon1 from a real presigned PUT).
DO_SPACES_REGION=lon1

# LangSmith tracing (issue #5) — optional; nothing is exported unless the API
# key is present. With the key set, every LLM call is traced hierarchically
# (agent run → step → inference → llm, token usage + latency). LANGCHAIN_PROJECT
# selects the LangSmith project traces land in (default project when unset).
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=tova
