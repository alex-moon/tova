# Copy to .env (on the live server, /opt/tova/.env) and fill in real values.
# Never commit real secrets. .env is git-ignored; docker-compose.live.yml loads it via env_file.

# Secrets (set for backend container)
GROQ_API_KEY=
JWT_SECRET=
MONGODB_PASSWORD=

# LangSmith tracing (issue #5) — optional; nothing is exported unless the API
# key is present. With the key set, every LLM call is traced hierarchically
# (agent run → step → inference → llm, token usage + latency). LANGCHAIN_PROJECT
# selects the LangSmith project traces land in (default project when unset).
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=tova
