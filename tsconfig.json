{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "types": ["node", "jest"],
    "outDir": "dist"
  },
  "include": ["src/index.ts", "src/server/**/*.ts"],
  "exclude": ["src/client", "src/server/**/*.test.ts", "src/server/test/**"]
}
