// #179: ship Tova's container logs to Grafana Cloud (hosted Loki).
//
// Alloy tails every container in this compose project via the Docker socket,
// keeps the app services, and pushes over the Loki push API with Grafana Cloud
// basic auth. Credentials come from the environment (see docker-compose.live.yml,
// fed by .env):
//   LOKI_URL      full Loki push URL, e.g.
//                 https://logs-prod-xxx.grafana.net/loki/api/v1/push
//   LOKI_USERNAME Grafana Cloud Loki instance ID
//   LOKI_PASSWORD API key / access policy token
//
// Note: the future admin query proxy needs the base URL, not this push URL —
// derive it by stripping the /loki/api/v1/push suffix, or add a separate var.

discovery.docker "tova" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "tova" {
  targets = discovery.docker.tova.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "tova"
    action        = "keep"
  }

  // Service allowlist: add new live-stack services here so Alloy scrapes them.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(backend|frontend)$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "tova" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.tova.targets
  labels        = { "job" = "tova" }
  relabel_rules = discovery.relabel.tova.rules
  forward_to    = [loki.write.tova.receiver]
}

loki.write "tova" {
  endpoint {
    url = sys.env("LOKI_URL")
    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}
