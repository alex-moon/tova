discovery.docker "tova" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "tova" {
  targets = discovery.docker.tova.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "tova"
    action        = "keep"
  }

  // Service allowlist: add new live-stack services here so Alloy scrapes them.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "^(backend|frontend)$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "tova" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.tova.targets
  labels        = { "job" = "tova" }
  relabel_rules = discovery.relabel.tova.rules
  forward_to    = [loki.write.tova.receiver]
}

loki.write "tova" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
