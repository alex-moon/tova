{
  "name": "tova",
  "version": "1.0.0",
  "description": "Chat application with intelligent multi-provider model routing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf src/client/dist node_modules src/client/node_modules",
    "install:all": "npm install && npm run install:client",
    "install:client": "npm --prefix src/client install",
    "postinstall": "npm --prefix src/client install",
    "build:client": "npm --prefix src/client run build",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "npm --prefix src/client run dev",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node dist/index.js",
    "stack:up": "docker compose -f docker-compose.local.yml up -d",
    "stack:down": "docker compose -f docker-compose.local.yml down",
    "deploy": "bash scripts/deploy.sh",
    "db:migrate": "tsx migrations/index.ts up",
    "db:migrate:down": "tsx migrations/index.ts down --last",
    "db:dump": "tsx scripts/db-sync.ts dump",
    "db:drop": "tsx scripts/db-sync.ts drop",
    "db:restore": "tsx scripts/db-sync.ts restore",
    "db:sync": "tsx scripts/db-sync.ts sync",
    "db:password": "tsx scripts/db-sync.ts password",
    "evals": "tsx scripts/run-evals.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src migrations --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:check": "npm run format",
    "format:fix": "prettier --write .",
    "fix": "npm run lint:fix && npm run format:fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "better-npm-audit audit --production --level high",
    "lint:server": "npm run lint",
    "format:server": "npm run format",
    "format:fix:server": "npm run format:fix",
    "test:server": "npm test",
    "lint:client": "npm --prefix src/client run lint",
    "format:client": "npm --prefix src/client run format",
    "format:fix:client": "npm --prefix src/client run format:fix",
    "test:client": "npm --prefix src/client run test",
    "build:server": "npm run typecheck",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "ci:server": "npm run lint:server && npm run format:server && npm run typecheck && npm run test:server",
    "ci:client": "npm run lint:client && npm run format:client && npm run test:client && npm run build:client",
    "ci": "npm run ci:client && npm run ci:server"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@mastra/core": "^1.66.0",
    "@mastra/langsmith": "^1.3.17",
    "@mastra/observability": "^1.17.7",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/canvas": "^0.1.80",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^0.30.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "mongo-migrate-ts": "^2.0.0",
    "mongoose": "^8.18.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^6.0.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "adm-zip": "^0.6.1",
    "better-npm-audit": "^3.11.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.0.5",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0"
  },
  "private": true
}
