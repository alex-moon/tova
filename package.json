{
  "name": "tova",
  "version": "1.0.0",
  "description": "Chat application with intelligent multi-provider model routing",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/server",
    "clean": "rm -rf dist node_modules apps/*/node_modules",
    "build:client": "npm run build -w apps/client",
    "dev:server": "tsx watch --tsconfig apps/server/tsconfig.json apps/server/src/main.ts",
    "dev:client": "npm run dev -w apps/client",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "start": "npm run start -w apps/server",
    "stack:up": "docker compose -f docker-compose.local.yml up -d",
    "stack:down": "docker compose -f docker-compose.local.yml down",
    "deploy": "bash scripts/deploy.sh",
    "db:migrate": "tsx apps/migrations/src/index.ts up",
    "db:migrate:down": "tsx apps/migrations/src/index.ts down --last",
    "db:dump": "tsx scripts/db-sync.ts dump",
    "db:drop": "tsx scripts/db-sync.ts drop",
    "db:restore": "tsx scripts/db-sync.ts restore",
    "db:sync": "tsx scripts/db-sync.ts sync",
    "db:password": "tsx scripts/db-sync.ts password",
    "db:backfill-embeddings": "tsx scripts/backfill-embeddings.ts",
    "db:vector-index": "tsx scripts/create-vector-index.ts",
    "logs": "tsx scripts/loki.ts",
    "evals": "tsx scripts/run-evals.ts",
    "evals:memory": "tsx scripts/run-memory-evals.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint apps --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:check": "npm run format",
    "format:fix": "prettier --write .",
    "fix": "npm run lint:fix && npm run format:fix",
    "typecheck": "npm run typecheck -w apps/server",
    "audit": "better-npm-audit audit --production --level high",
    "lint:server": "npm run lint",
    "format:server": "npm run format",
    "format:fix:server": "npm run format:fix",
    "test:server": "npm test",
    "lint:client": "npm run lint -w apps/client",
    "format:client": "npm run format -w apps/client",
    "format:fix:client": "npm run format:fix -w apps/client",
    "test:client": "npm run test -w apps/client",
    "build:server": "npm run typecheck",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "ci:server": "npm run lint:server && npm run format:server && npm run typecheck && npm run test:server",
    "ci:client": "npm run lint:client && npm run format:client && npm run test:client && npm run build:client",
    "ci": "npm run ci:client && npm run ci:server"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "adm-zip": "^0.6.1",
    "better-npm-audit": "^3.11.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.0.5",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0"
  },
  "private": true
}
