{
  "name": "@tova/migrations",
  "version": "1.0.0",
  "private": true,
  "description": "Tova Mongo schema migrations (mongo-migrate-ts, run via tsx)",
  "scripts": {
    "migrate": "tsx src/index.ts up",
    "migrate:down": "tsx src/index.ts down --last"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.1",
    "mongo-migrate-ts": "^2.0.0",
    "mongodb": "^6.21.0",
    "tsx": "^4.20.3"
  }
}
